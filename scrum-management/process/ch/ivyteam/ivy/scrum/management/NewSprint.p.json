            { "name" : "sprintId", "type" : "String", "desc" : "" }
          ],
          "map" : { }
        },
        "request" : {
          "name" : "New Sprint",
          "description" : "Create a new sprint that will also be  shown on the Sprint Overview"
        }
      },

    }, {
      "id" : "f25",
      "type" : "Script",
      "name" : "Calculate",
      "config" : {
        "output" : {
          "code" : [
            "import java.util.Calendar;",
            "",
            "int maxworkingdays = 0;",
            "",
            "if (in.sprint.startDate != null && in.sprint.endDate != null) {",
            "",
            "    Calendar currentDate = Calendar.getInstance();",
            "    currentDate.setTime(in.sprint.startDate);",
            "",
            "    Calendar endDate = Calendar.getInstance();",
            "    endDate.setTime(in.sprint.endDate);",
            "",
            "    while (!currentDate.after(endDate)) {",
            "",
            "        int day = currentDate.get(Calendar.DAY_OF_WEEK);",
            "",
            "        if (day != Calendar.SATURDAY && day != Calendar.SUNDAY) {",
            "            maxworkingdays++;",
            "        }",
            "",
            "        currentDate.add(Calendar.DAY_OF_MONTH, 1);",
            "    }",
            "    maxworkingdays--;",
            "",
            "    in.sprint.maxWorkingDays = maxworkingdays;",
            "}"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 224, "y" : 552 },
        "description" : "Calculates the max working days excludes review day and weekends (saturday, sunday)"
      },
      "connect" : [
        { "id" : "f26", "to" : "f23", "color" : "default" }
      ]

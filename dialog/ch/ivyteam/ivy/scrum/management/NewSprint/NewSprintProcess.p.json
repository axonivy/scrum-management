          "code" : [
            "import java.lang.Thread;",
            "ivy.log.info(in.sprint.versionCode);",
            "ivy.log.info(in.sprint.sprintNumber);",
            "ivy.log.info(in.sprint.sprintPointsPerDay);",
            "ivy.log.info(in.sprint.startDate);",
            "ivy.log.info(in.sprint.endDate);",
            "",
            "ivy.repo.save(in.sprint);",
            "",
            "Object lastSprint = ivy.repo.search(in.sprint.class)",
            "    .execute()",
            "    .getAll()",
            "    .get(0);",
            "",
            "out.sprint = lastSprint as ch.ivyteam.ivy.scrum.management.Sprint;",
            "",
            "ivy.log.info(\"VERSION: \" + out.sprint.versionCode);",
            "ivy.log.info(\"NUMBER: \" + out.sprint.sprintNumber);",
            "ivy.log.info(\"MAX DAYS: \" + out.sprint.maxWorkingDays);",
            "ivy.log.info(\"POINTS/DAY: \" + out.sprint.sprintPointsPerDay);",
            "ivy.log.info(\"START: \" + out.sprint.startDate);",
            "ivy.log.info(\"END: \" + out.sprint.endDate);"
          ]
        }
      },

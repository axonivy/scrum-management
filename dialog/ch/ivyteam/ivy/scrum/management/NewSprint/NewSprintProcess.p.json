      "type" : "Script",
      "name" : "Loads BusinessData -> Dataclass",
      "config" : {
        "output" : {
          "code" : [
            "java.util.List<Object> sprints = ivy.repo.search(in.sprint.class)",
            "    .execute()",
            "    .getAll();",
            "if (!sprints.isEmpty()) {",
            "    Object lastSprint = sprints.getLast();",
            "    out.sprint = lastSprint as ch.ivyteam.ivy.scrum.management.Sprint;",
            "    in.sprint.sprintNumber++;",
            "    out.sprint.startDate = out.sprint.startDate.add(new Duration(\"P21D\"));",
            "    out.sprint.endDate = out.sprint.endDate.add(new Duration(\"P21D\"));",
            "    in.sprint.maxWorkingDays = 12;",
            "",
            "}"
          ]
        }
      },

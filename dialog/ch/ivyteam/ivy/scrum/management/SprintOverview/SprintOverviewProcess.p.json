      "id" : "f6",
      "type" : "Script",
      "name" : "Creating Variables",
      "config" : {
        "output" : {
          "code" : [
            "import ch.ivyteam.ivy.scrum.management.Sprint;",
            "import java.util.Random;",
            "import ch.ivyteam.ivy.scrum.management.SprintUser;",
            "import ch.ivyteam.ivy.scrum.management.Sprint;",
            "java.util.List<Sprint> sprints = ivy.repo.search(Sprint.class)",
            "    .execute()",
            "    .getAll();",
            "if (!sprints.isEmpty()) {",
            "    Sprint lastSprint = sprints.getLast() as Sprint;",
            "    out.sprint = lastSprint;",
            "}",
            "",
            "int Repetitions = 20;",
            "int i = 0;",
            "int max = in.sprint.maxWorkingDays;",
            "int min = in.sprint.maxWorkingDays / 2;",
            "",
            "while (i < Repetitions) {",
            "  in.sprint.members.add(new SprintUser());",
            "  in.sprint.members.get(i).name = \"TestUser\";",
            "  in.sprint.members.get(i).workingDays = new java.util.Random().nextInt(max-min+1) + min; ",
            "  in.sprint.members.get(i).capacity = new java.util.Random().nextInt(51) + 50;",
            "  i++;",
            "}"
          ]
        }
      },

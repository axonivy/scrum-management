            "import ch.ivyteam.ivy.security.user.IUserRepository;",
            "import ch.ivyteam.ivy.security.IUser;",
            "import ch.ivyteam.ivy.scrum.management.SprintUser;",
            "import java.util.Random;",
            "",
            "in.sprint.versionCode = \"Diavolezza\";",
            "in.sprint.startDate = new Date(\"2026-08-07\");",
            "in.sprint.endDate = new Date(\"2026-08-29\");",
            "",
            "in.sprint.members.clear();",
            "",
            "Random rand = new Random();",
            "",
            "for (int i = 1; i <= 30; i++) {",
            "    SprintUser user = new SprintUser();",
            "    user.name = \"Test user \" + i;",
            "    user.workingDays = rand.nextInt(13) + 10; ",
            "    user.capacity = rand.nextInt(60,100);",
            "    in.sprint.members.add(user);",
            "}"
          ]
        }
      },

      "type" : "Script",
      "name" : "Totalpoints",
      "config" : {
        "output" : {
          "code" : [
            "import ch.ivyteam.ivy.scrum.management.SprintUser; ",
            "in.totalpoints = 0; ",
            "for (SprintUser member : in.sprint.members) { ",
            "   in.totalpoints = in.totalpoints + member.workingDays.doubleValue() * (member.capacity.doubleValue() / 100) * in.sprint.sprintPointsPerDay; ",
            "  }"
          ]
        }
      },
